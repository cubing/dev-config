{
  "root": false,
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useGlobalThis": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "useJsonImportAttributes": "error"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["CODE_OF_CONDUCT.md", "LICENSE.md", "LICENSE-*.md"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
